# Copy to .env and fill in. NEVER commit .env
FLASK_ENV=development
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=autilearn_user
DB_PASSWORD=your_password
DB_NAME=autilearn

# Comma-separated. Capacitor Android uses https://localhost (or http://localhost), iOS uses capacitor://localhost
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost,https://localhost,capacitor://localhost
